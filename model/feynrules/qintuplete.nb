Cell["CORRECCION (oct 2026): en Dev, el termino de derivada va dividido por 15. Dev se usa siempre dentro de Sum sobre jj (5 valores) y aaa (3 valores); la derivada no depende de esos indices y antes quedaba multiplicada por 15, con el termino cinetico en -225/4 en vez de -1/4. Con el /15 la suma devuelve la derivada una sola vez. Los generadores gen5 se corrigen en vquint.fr (sin el factor 1/Sqrt[20]). El prefactor de LVVpi lleva ahora el factor 2 Sqrt[6] Cos[cabi] (isospin 2 y V_ud), que reproduce Gamma = 6 GF^2 fpi^2 Vud^2 dm^3 Sqrt[1-mpi^2/dm^2]/Pi con fpi = 130 MeV. La celda siguiente agrega el vertice V++ V+ pi (LVVpipp) y redefine Lfinal.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Dev", "[", 
     RowBox[{
     "vec_", ",", "Wi_", ",", "m_", ",", "n_", ",", "i_", ",", "j_", ",", 
      "aa_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"del", "[", 
       RowBox[{
        RowBox[{"vec", "[", 
         RowBox[{"m", ",", "i"}], "]"}], ",", "n"}], "]"}], "/", "15"}], "-", 
     RowBox[{"I", " ", "gw", " ", 
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"Part", "[", 
         RowBox[{"gen5", ",", "aa"}], "]"}], ",", "i", ",", "j"}], "]"}], " ", 
      RowBox[{"vec", "[", 
       RowBox[{"m", ",", "j"}], "]"}], " ", 
      RowBox[{"Wi", "[", 
       RowBox[{"n", ",", "aa"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lminimal", ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mu", ",", "nu", ",", "iii", ",", "jjj", ",", "ll", ",", "lll", ",", 
        "kk", ",", "kkk", ",", "feynmangaugerules"}], "}"}], ",", 
      RowBox[{
       RowBox[{"feynmangaugerules", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Not", "[", "FeynmanGauge", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"G0", "|", "GP", "|", "GPbar"}], "\[Rule]", "0"}], "}"}], 
          ",", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ExpandIndices", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "4"}], 
            RowBox[{"Sum", "[", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"HC", "[", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Dev", "[", 
                    RowBox[{
                    "Vquint", ",", "Wi", ",", "mu", ",", "nu", ",", "ii", ",",
                     "jj", ",", "aaa"}], "]"}], "-", 
                    RowBox[{"Dev", "[", 
                    RowBox[{
                    "Vquint", ",", "Wi", ",", "nu", ",", "mu", ",", "ii", ",",
                     "jj", ",", "aaa"}], "]"}]}], ")"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"jj", ",", "1", ",", "5"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"aaa", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}],
                " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Dev", "[", 
                    RowBox[{
                    "Vquint", ",", "Wi", ",", "mu", ",", "nu", ",", "ii", ",",
                     "jj", ",", "aaa"}], "]"}], "-", 
                   RowBox[{"Dev", "[", 
                    RowBox[{
                    "Vquint", ",", "Wi", ",", "nu", ",", "mu", ",", "ii", ",",
                     "jj", ",", "aaa"}], "]"}]}], ")"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"jj", ",", "1", ",", "5"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"aaa", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ",", 
              
              RowBox[{"{", 
               RowBox[{"ii", ",", "1", ",", "5"}], "}"}]}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", "mv", " ", "mv", " ", 
            RowBox[{"anti", "[", 
             RowBox[{"Vquint", "[", 
              RowBox[{"mu", ",", "iii"}], "]"}], "]"}], " ", 
            RowBox[{"Vquint", "[", 
             RowBox[{"mu", ",", "iii"}], "]"}]}]}], ",", 
          RowBox[{"FlavorExpand", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"SU2Q", ",", "SU2W"}], "}"}]}]}], "]"}], "/.", 
        "feynmangaugerules"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lnonminimal", ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mu", ",", "nu", ",", "iii", ",", "jjj", ",", "ll", ",", "lll", ",", 
       "kk", ",", "kkk", ",", "feynmangaugerules"}], "}"}], ",", 
     RowBox[{
      RowBox[{"feynmangaugerules", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Not", "[", "FeynmanGauge", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"G0", "|", "GP", "|", "GPbar"}], "\[Rule]", "0"}], "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ExpandIndices", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"kappa", "*", "I", " ", "gw", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"HC", "[", 
               RowBox[{"Vquint", "[", 
                RowBox[{"mu", ",", "i"}], "]"}], "]"}], 
              RowBox[{"FS", "[", 
               RowBox[{"Wi", ",", "mu", ",", "nu", ",", "a"}], "]"}], 
              RowBox[{"Part", "[", 
               RowBox[{
                RowBox[{"Part", "[", 
                 RowBox[{"gen5", ",", "a"}], "]"}], ",", "i", ",", "j"}], 
               "]"}], 
              RowBox[{"Vquint", "[", 
               RowBox[{"nu", ",", "j"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"a", ",", "1", ",", "3"}], "}"}]}], "]"}]}], "+", 
          RowBox[{"xiinv", "*", 
           RowBox[{"Sum", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"HC", "[", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Dev", "[", 
                   RowBox[{
                   "Vquint", ",", "Wi", ",", "mu", ",", "mu", ",", "ii", ",", 
                    "jj", ",", "aaa"}], "]"}], ")"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"jj", ",", "1", ",", "5"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"aaa", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}], 
              " ", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"Dev", "[", 
                  RowBox[{
                  "Vquint", ",", "Wi", ",", "nu", ",", "nu", ",", "ii", ",", 
                   "jj", ",", "aaa"}], "]"}], ")"}], ",", 
                RowBox[{"{", 
                 RowBox[{"jj", ",", "1", ",", "5"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"aaa", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"ii", ",", "1", ",", "5"}], "}"}]}], "]"}]}]}], ",", 
         RowBox[{"FlavorExpand", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"SU2Q", ",", "SU2W"}], "}"}]}]}], "]"}], "/.", 
       "feynmangaugerules"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lvvh", ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mu", ",", "nu", ",", "iii", ",", "jjj", ",", "ll", ",", "lll", ",", 
       "kk", ",", "kkk", ",", "feynmangaugerules"}], "}"}], ",", 
     RowBox[{
      RowBox[{"feynmangaugerules", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Not", "[", "FeynmanGauge", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"G0", "|", "GP", "|", "GPbar"}], "\[Rule]", "0"}], "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ExpandIndices", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], "*", "lambdav", "*", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"HC", "[", 
              RowBox[{"Vquint", "[", 
               RowBox[{"mu", ",", "i"}], "]"}], "]"}], " ", 
             RowBox[{"Vquint", "[", 
              RowBox[{"mu", ",", "i"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Phibar", "[", "iii", "]"}], " ", 
            RowBox[{"Phi", "[", "iii", "]"}]}], ")"}]}], ",", 
         RowBox[{"FlavorExpand", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"SU2D", ",", "SU2Q", ",", "SU2W"}], "}"}]}]}], "]"}], "/.",
        "feynmangaugerules"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lquint", ":=", 
   RowBox[{"Lminimal", "+", "Lnonminimal", "+", "Lvvh"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LVVpi", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", "6", "]"}], "*", 
         RowBox[{"Cos", "[", "cabi", "]"}]}], "*", 
        RowBox[{"gw", "^", "2"}], "*", 
        RowBox[{"fPi", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Sqrt", "[", "2", "]"}], "*", "2", " ", 
           RowBox[{"MW", "^", "2"}]}], ")"}]}]}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Vplus", "[", "nu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"V0", "[", "nu", "]"}], ",", "mu"}], "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pipbar", ",", "mu"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"Vplus", "[", "nu", "]"}], ",", "mu"}], "]"}], " ", 
        RowBox[{"V0", "[", "nu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pipbar", ",", "mu"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"Vplus", "[", "nu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"V0", "[", "mu", "]"}], ",", "nu"}], "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pipbar", ",", "mu"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"Vplus", "[", "nu", "]"}], ",", "mu"}], "]"}], " ", 
        RowBox[{"V0", "[", "mu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pipbar", ",", "nu"}], "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", "6", "]"}], "*", 
         RowBox[{"Cos", "[", "cabi", "]"}]}], "*", 
        RowBox[{"gw", "^", "2"}], "*", 
        RowBox[{"fPi", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Sqrt", "[", "2", "]"}], "*", "2", " ", 
           RowBox[{"MW", "^", "2"}]}], ")"}]}]}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Vplusbar", "[", "nu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"V0", "[", "nu", "]"}], ",", "mu"}], "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pip", ",", "mu"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"Vplusbar", "[", "nu", "]"}], ",", "mu"}], "]"}], "*", 
        RowBox[{"V0", "[", "nu", "]"}], "*", 
        RowBox[{"del", "[", 
         RowBox[{"pip", ",", "mu"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"Vplusbar", "[", "nu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"V0", "[", "mu", "]"}], ",", "nu"}], "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pip", ",", "mu"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"del", "[", 
         RowBox[{
          RowBox[{"Vplusbar", "[", "nu", "]"}], ",", "mu"}], "]"}], " ", 
        RowBox[{"V0", "[", "mu", "]"}], " ", 
        RowBox[{"del", "[", 
         RowBox[{"pip", ",", "nu"}], "]"}]}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
