Cell["LVVpipp := -(Cos[cabi]*gw^2*fPi/(Sqrt[2]*MW^2))*(Vplusplus[nu] del[Vplusbar[nu],mu] del[pipbar,mu] - del[Vplusplus[nu],mu] Vplusbar[nu] del[pipbar,mu] - Vplusplus[nu] del[Vplusbar[mu],nu] del[pipbar,mu] - del[Vplusplus[nu],mu] Vplusbar[mu] del[pipbar,nu]) - (Cos[cabi]*gw^2*fPi/(Sqrt[2]*MW^2))*(Vplusplusbar[nu] del[Vplus[nu],mu] del[pip,mu] - del[Vplusplusbar[nu],mu] Vplus[nu] del[pip,mu] - Vplusplusbar[nu] del[Vplus[mu],nu] del[pip,mu] - del[Vplusplusbar[nu],mu] Vplus[mu] del[pip,nu]);\nLfinal := Lquint + LVVpi + LVVpipp;", "Input"],

